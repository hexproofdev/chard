#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-3-Clause
#
# Installed by `make hooks`, never automatically: a repository that rewrites the
# developer's git configuration as a side effect of building is doing something they
# did not ask for.
#
# This runs the formatting check and the house lint standard's gate over the lint tables, and
# nothing else: seconds. Clippy and the tests belong to `make check`, which a contributor
# runs deliberately and CI runs again, and which refuses to run where the hooks are not
# installed; a hook that runs the full gate gets disabled the first time someone is in a
# hurry, and a disabled hook protects nothing. The formatting check and the lint tables' gate
# are here because each costs a second and fails the gate minutes later otherwise.
#
# What is not here, and why: a check that builds anything. The hook admits a check only
# where it takes a few seconds on a tree whose sources just changed.

set -euo pipefail

if ! cargo fmt --check >/dev/null 2>&1 || ! (cd fuzz && cargo fmt --check) >/dev/null 2>&1; then
  cat >&2 <<'EOF'

The commit was refused because the tree is not formatted: run `make fmt` and commit again.
`make check` would refuse it at `fmt-check`.
EOF
  exit 1
fi

if ! lints=$(sh .lints/std/lints-gate.sh 2>&1); then
  printf '%s\n' "$lints" >&2
  cat >&2 <<'EOF'

The commit was refused by the house lint standard's gate (above): a lint table or clippy.toml
is not what the standard's files assemble to, a manifest does not inherit the lints, or a lint
is lowered where the standard does not allow it. `make check` would refuse it at `lints`.
EOF
  exit 1
fi
