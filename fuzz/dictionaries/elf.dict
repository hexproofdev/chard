x86_feature_1_and="\x02\x00\x00\xc0"
aarch64_feature_1_and="\x00\x00\x00\xc0"
x86_isa_1_used="\x02\x80\x00\xc0"
pt_note="\x04\x00\x00\x00"
pt_dynamic="\x02\x00\x00\x00"
pt_interp="\x03\x00\x00\x00"
pt_gnu_stack="\x51\xe5\x74\x64"
pt_gnu_relro="\x52\xe5\x74\x64"
pt_gnu_property="\x53\xe5\x74\x64"
em_x86_64="\x3e\x00"
em_aarch64="\xb7\x00"
em_386="\x03\x00"
dt_flags_1="\xfb\xff\xff\x6f"
