dt_relr="\x24\x00\x00\x00"
dt_debug="\x15\x00\x00\x00"
dt_textrel="\x16\x00\x00\x00"
name_0=".note.gnu.property"
name_1=".dynamic"
name_2=".dynstr"
name_3=".dynsym"
name_4=".symtab"
name_5=".strtab"
name_6=".comment"
name_7=".shstrtab"
name_8=".chard.report"
name_9=".note.GNU-stack"
name_10=".relr.dyn"
name_11=".interp"
name_12="__stack_chk_fail"
name_13="__fortify_fail"
name_14="__memcpy_chk"
name_15="_FORTIFY_SOURCE"
name_16="Linker: LLD"
name_17="GCC: (GNU)"
name_18="clang version"
name_19="libc.so.6"
name_20="ld-linux-x86-64.so.2"
# The code reader (`elf::code`): the function it searches, the table it
# finds it through, an executable section's flags, and the three trap encodings.
name_21="chard_ubsan_trap_probe"
name_22=".symtab"
name_23=".strtab"
shf_alloc_execinstr="\x06\x00\x00\x00\x00\x00\x00\x00"
stt_func_global="\x12"
x86_ud2="\x0f\x0b"
x86_ud1="\x0f\xb9"
a64_brk_gcc="\x00\x7d\x20\xd4"
a64_brk_clang="\x80\xa2\x2a\xd4"
name_24="chard_fortify_printf_probe"
name_25="_ZL6printfPKcU17pass_object_size1z"
name_26="_ZL6printfPKcU25pass_dynamic_object_size1z"
name_27="__vprintf_chk"
x86_mov_edi_1="\xbf\x01\x00\x00\x00"
x86_mov_edi_2="\xbf\x02\x00\x00\x00"
x86_push_2="\x6a\x02"
a64_mov_w0_1="\x20\x00\x80\x52"
a64_mov_w0_2="\x40\x00\x80\x52"
# gcc's cold part of the trap probe's function, a local
# `STT_FUNC`, and the call encodings the trap probe's function is also searched for.
name_28="chard_ubsan_trap_probe.cold"
stt_func_local="\x02"
x86_call_rel32="\xe8\x00\x00\x00\x00"
x86_call_got="\xff\x15\x00\x00\x00\x00"
a64_bl="\x00\x00\x00\x94"
a64_blr_x16="\x00\x02\x3f\xd6"
# clang's large-model calls, through a register and
# through a GOT entry two registers address.
x86_call_reg_rax="\xff\xd0"
x86_call_sib="\xff\x14"
# The trap probe's third and fourth functions, and clang's
# `brk #0x5506`, the `function` check's trap, which `a64-brk-clang-check` reads.
name_29="chard_ubsan_trap_sized"
name_30="chard_ubsan_trap_indirect"
a64_brk_clang_function="\xc0\xa0\x2a\xd4"
# clang's trap with a check number, and its signed-overflow trap, whose number is 0.
x86_ud1_check="\x0f\xb9\x40"
x86_ud1_overflow="\x0f\xb9\x00"
a64_brk_overflow="\x00\xa0\x2a\xd4"
