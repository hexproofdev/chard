#
# libFuzzer dictionary for `driver_text`: the line shapes a `-###` listing, a `-v` report, a
# `--version` banner and a `.comment` section print, and the words the readers take.
lf="\x0a"
cr="\x0d"
command=" /"
quoted=" \""
q="\""
bs="\\"
cc1="cc1"
cc1_flag="\"-cc1\""
collect2="collect2"
triple="-triple"
D="-D"
U="-U"
isystem="-isystem"
include="-include"
resource_dir="-resource-dir="
sysroot="--sysroot="
isysroot="-isysroot"
internal_isystem="-internal-isystem"
undef="-undef"
nostdinc="-nostdinc"
m32="-m32"
mx32="-mx32"
pic_level="-pic-level"
reloc="-mrelocation-model"
pie="-pic-is-pie"
lto="-flto=thin"
fno_lto="-fno-lto"
sanitize="-fsanitize=address"
exception_model="-exception-model="
exception_model_word="-exception-model"
sjlj="-fsjlj-exceptions"
fuse_ld="-fuse-ld="
ld_path="--ld-path="
configured="Configured with:"
config_file="Configuration file:"
specs="Reading specs from "
builtin="Using built-in specs."
linker="Linker: "
lld="LLD "
mold="mold "
gnu_ld="GNU ld"
gold="GNU gold"
fhardened="-fhardened"
whardened="-Whardened"
x86_64="x86_64"
amd64="amd64"
arm64="arm64"
i686="i686"
dash="-"
