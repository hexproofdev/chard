# SPDX-License-Identifier: BSD-3-Clause
#
# libFuzzer dictionary for `env_reads`: the field separator and the three read markers, the
# words of the files the observer reads, and the kernel spellings the byte-order rule names.
field="\x1e"
none="\x18"
absent="\x15"
refused="\x06"
nul="\x00"
lf="\x0a"
identity="0 0 4294967295"
max="4294967295"
over="4294967296"
container="container="
oci="container=oci"
lxc="lxc"
docker="docker"
libpod="libpod"
containerd="containerd"
nspawn="systemd-nspawn"
podman="podman"
systemd="systemd"
init="init"
cgroup="0::/"
be="_be"
eb="eb"
le="le"
el="el"
armv7l="armv7l"
armv7b="armv7b"
aarch64="aarch64"
mips="mips"
mips64="mips64"
ppc64le="ppc64le"
s390x="s390x"
riscv64="riscv64"
loongarch64="loongarch64"
esc="\x1b"
rlo="\xe2\x80\xae"
line_separator="\xe2\x80\xa8"
zero_width="\xe2\x80\x8b"
backslash="\\"
backtick="`"
