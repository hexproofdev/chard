# SPDX-License-Identifier: BSD-3-Clause
#
# libFuzzer dictionary for `parse_macros`: the shape of a `-dM -E` dump and the macro names
# chard reads from one.
define="#define "
define_bare="#define"
lf="\x0a"
crlf="\x0d\x0a"
cr="\x0d"
space=" "
tab="\x09"
under="__"
lparen="("
rparen=")"
comma=","
backslash="\\"
ellipsis="..."
param="(x)"
one=" 1"
two=" 2"
three=" 3"
name_0="__SSP__"
name_1="__SSP_STRONG__"
name_2="__SSP_ALL__"
name_3="__PIE__"
name_4="__PIC__"
name_5="__OPTIMIZE__"
name_6="__OPTIMIZE_SIZE__"
name_7="__NO_INLINE__"
name_8="__FAST_MATH__"
name_9="__CET__"
name_10="__EXCEPTIONS"
name_11="__GNUC__"
name_12="__clang_major__"
name_13="__STDC_VERSION__"
name_14="__GLIBC__"
name_15="__GLIBC_MINOR__"
name_16="__GLIBCXX__"
name_17="__USE_FORTIFY_LEVEL"
name_18="_FORTIFY_SOURCE"
name_19="_FORTIFY_IMPL"
name_20="_FILE_OFFSET_BITS"
name_21="_GLIBCXX_ASSERTIONS"
name_22="_LIBCPP_VERSION"
name_23="_LIBCPP_HARDENING_MODE"
name_24="_LIBCPP_HARDENING_MODE_FAST"
name_25="__SANITIZE_ADDRESS__"
name_26="__SANITIZE_UNDEFINED__"
name_27="__ARM_FEATURE_BTI_DEFAULT"
name_28="__ARM_FEATURE_PAC_DEFAULT"
name_29="__ARM_FEATURE_GCS_DEFAULT"
name_30="__has_builtin"
name_31="__has_include"
