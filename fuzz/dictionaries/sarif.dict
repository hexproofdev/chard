open="{"
close="}"
runs="\"runs\""
results="\"results\""
message="\"message\""
text="\"text\""
level="\"level\""
error="\"error\""
warning="\"warning\""
note="\"note\""
none="\"none\""
version="\"version\": \"2.1.0\""
schema="\"$schema\""
ruleId="\"ruleId\""
banner="clang: warning: diagnostic formatting in SARIF mode is currently unstable [-Wsarif-format-unstable]"
